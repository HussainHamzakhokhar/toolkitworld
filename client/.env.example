# Copy to .env.production (or set in Cloudflare Pages > Settings > Environment variables)
# Your live site address, no trailing slash. Used for canonical URLs, sitemap and Open Graph tags.
VITE_SITE_URL=https://toolkitworld.pages.dev

# Optional contact details. Leave empty until you have real ones. Nothing fake is ever shown.
VITE_CONTACT_EMAIL=
# Optional: URL of the ToolKitWorld API server (server/ folder), enables the contact form.
VITE_API_URL=
# Name of the person or business operating the site (shown in legal pages).
VITE_OWNER_NAME=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Empty = analytics disabled.
VITE_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification code (content="..." value only).
VITE_GSC_VERIFICATION=

# Google AdSense. Leave empty until AdSense gives you real values. Ads never load with placeholders.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_IN_CONTENT=
VITE_ADSENSE_SLOT_BELOW_RESULT=
VITE_ADSENSE_SLOT_SIDEBAR=
